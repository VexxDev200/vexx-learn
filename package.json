{
  "name": "vexx-learn",
  "version": "0.2.1",
  "private": true,
  "description": "Vexx Learn — лаунчер обучения кодингу (Python, Java, C++, C#)",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "courses": "node scripts/build-all-courses.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "pack:updates": "node scripts/pack-updates.mjs",
    "release:pack": "npm run courses && npm run pack:updates",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run icon && npm run courses && vite build && node scripts/copy-course-data.mjs && electron-builder --win portable",
    "start": "electron ."
  },
  "build": {
    "appId": "dev.vexx.learn",
    "productName": "Vexx Learn",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "public/**/*", "lessons/**/*", "update.config.json", "package.json"],
    "icon": "build/icon.ico",
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico",
      "artifactName": "Vexx-Learn-Portable.${ext}"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  }
}
