node_modules/
dist/
*.log

# Portable exe / builder output — не в git
release/*.exe
release/win-unpacked/
release/builder-effective-config.yaml
release/builder-debug.yml

# Уроки для авто-обновления — в git
!release/updates/
!release/updates/**

# Local OTA config (owner/repo only, never secrets). Template: update.config.example.json
update.config.json

# Local environment files (may hold secrets); only a template may be committed
.env
.env.*
!.env.example
